# Cloudflare Pages 自定义响应头。Pages 走静态发布、不经过 server.js / worker.js，
# 所以安全头必须在这里声明，否则线上是「零响应头」状态。
# 配方与 functions/worker.js 保持一致 —— 那两条路径的测试已在同一 CSP 下跑通。
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://raw.githubusercontent.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  X-Frame-Options: DENY
